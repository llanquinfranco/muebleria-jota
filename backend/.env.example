# Puerto en el que escucha el servidor Express en desarrollo local
PORT=5000

# Cadena de conexión a MongoDB Atlas (Reemplazar con tu usuario, contraseña y cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<nombre-db>?retryWrites=true&w=majority

# Origen permitido para CORS (frontend en Vite por defecto)
CLIENT_URL=http://localhost:5173

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave secreta utilizada para firmar y verificar los tokens JWT
JWT_SECRET=ingresar_clave_secreta